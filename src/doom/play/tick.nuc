;
; P_Ticker (p_tick.c): one tic of the level. The list itself is
; doom.play.thinkers.

(ns doom.play.tick)

(import-use doom.defs)
(import-use doom.world)
(import-use doom.state)
(import-use doom.play.thinkers)
(import-use doom.play.mobj)
(import-use doom.play.movers)
(import-use doom.play.lights)
(import-use doom.play.spec)
(import-use doom.play.user)

; What the C keeps as each thinker's function pointer.
(defn- think (n:&ThinkerNode):void
  (match (n 'self)
    ((mobj m) (mobj-thinker m))
    ((door d) (vertical-door d))
    ((floor f) (move-floor f))
    ((ceiling c) (move-ceiling c))
    ((plat p) (plat-raise p))
    ((fire-flicker f) (fire-flicker f))
    ((light-flash l) (light-flash l))
    ((strobe s) (strobe-flash s))
    ((glow g) (glow g))
    (_ (do))))

(defn ticker ():void
  (when paused (return))
  ; The menu pauses a single-player game, once the view has been set up.
  (when (and (not netgame) menu-active (not demo-playback) (!= (((player console-player) 'viewz) 'v) 1))
    (return))
  (dotimes (i MAX-PLAYERS)
    (when (aref player-in-game i) (player-think (player i))))
  (run-thinkers think)
  (update-specials)
  (respawn-specials)
  (inc! level-time))
