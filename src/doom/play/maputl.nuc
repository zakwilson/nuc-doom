;
; Map geometry for the playsim (p_maputl.c): line sides, openings, the
; blockmap links and iterators, and the intercept traversal that hitscans,
; aiming and use lines walk.

(ns doom.play.maputl)

(import-use doom.math)
(import-use doom.world)
(import-use doom.table)
(import-use doom.system)
(import-use doom.geom)
(import-use doom.info)

(defconst- MAPBTOFRAC (- MAPBLOCKSHIFT FRAC-BITS))
(defconst PT-ADDLINES 1)
(defconst PT-ADDTHINGS 2)
(defconst PT-EARLYOUT 4)

(defn approx-distance (dx:Fixed dy:Fixed):Fixed
  (let (ax (fx-abs dx) ay (fx-abs dy))
    (if (< ax ay)
      (- (+ ax ay) (fx-shr ax 1))
      (- (+ ax ay) (fx-shr ay 1)))))

(defn point-on-line-side (x:Fixed y:Fixed line:&Line):i32
  (let (v1 (line 'v1) ldx ((line 'dx) 'v) ldy ((line 'dy) 'v))
    (cond (= ldx 0) (if (<= x (v1 'x)) (if (> ldy 0) 1 0) (if (< ldy 0) 1 0))
      (= ldy 0) (if (<= y (v1 'y)) (if (< ldx 0) 1 0) (if (> ldx 0) 1 0))
      true (let (left (* (Fixed (bit-shr ldy FRAC-BITS)) (- x (v1 'x)))
                 right (* (- y (v1 'y)) (Fixed (bit-shr ldx FRAC-BITS))))
             (if (< right left) 0 1)))))

; 0 or 1 when the box is wholly on one side, -1 when the line crosses it.
(defn box-on-line-side (box:ptr:Fixed ld:&Line):i32
  (let (v1 (ld 'v1) p1:i32 0 p2:i32 0)
    (case (ld 'slope-type)
      ST-HORIZONTAL
      (do (set! p1 (if (> (aref box BOXTOP) (v1 'y)) 1 0))
          (set! p2 (if (> (aref box BOXBOTTOM) (v1 'y)) 1 0))
          (when (< ((ld 'dx) 'v) 0)
            (set! p1 (bit-xor p1 1))
            (set! p2 (bit-xor p2 1))))
      ST-VERTICAL
      (do (set! p1 (if (< (aref box BOXRIGHT) (v1 'x)) 1 0))
          (set! p2 (if (< (aref box BOXLEFT) (v1 'x)) 1 0))
          (when (< ((ld 'dy) 'v) 0)
            (set! p1 (bit-xor p1 1))
            (set! p2 (bit-xor p2 1))))
      ST-POSITIVE
      (do (set! p1 (point-on-line-side (aref box BOXLEFT) (aref box BOXTOP) ld))
          (set! p2 (point-on-line-side (aref box BOXRIGHT) (aref box BOXBOTTOM) ld)))
      ST-NEGATIVE
      (do (set! p1 (point-on-line-side (aref box BOXRIGHT) (aref box BOXTOP) ld))
          (set! p2 (point-on-line-side (aref box BOXLEFT) (aref box BOXBOTTOM) ld)))
      (do))
    (if (= p1 p2) p1 -1)))

(defstruct Divline x:Fixed y:Fixed dx:Fixed dy:Fixed)

(defn point-on-divline-side (x:Fixed y:Fixed line:&Divline):i32
  (let (ldx ((line 'dx) 'v) ldy ((line 'dy) 'v))
    (cond (= ldx 0) (if (<= x (line 'x)) (if (> ldy 0) 1 0) (if (< ldy 0) 1 0))
      (= ldy 0) (if (<= y (line 'y)) (if (< ldx 0) 1 0) (if (> ldx 0) 1 0))
      true (let (dx ((- x (line 'x)) 'v) dy ((- y (line 'y)) 'v))
             ; Opposite signs settle it without the multiply.
             (if (< (bit-xor (bit-xor ldy ldx) (bit-xor dx dy)) 0)
               (if (< (bit-xor ldy dx) 0) 1 0)
               (let (left (* (Fixed (bit-shr ldy 8)) (Fixed (bit-shr dx 8)))
                     right (* (Fixed (bit-shr dy 8)) (Fixed (bit-shr ldx 8))))
                 (if (< right left) 0 1)))))))

(defn divline-of (li:&Line):Divline
  (Divline ((li 'v1) 'x) ((li 'v1) 'y) (li 'dx) (li 'dy)))

; How far along v2 it crosses v1, as a fraction of v2.
(defn intercept-vector (v2:&Divline v1:&Divline):Fixed
  (let (den (- (* (fx-shr (v1 'dy) 8) (v2 'dx)) (* (fx-shr (v1 'dx) 8) (v2 'dy))))
    (if (= (den 'v) 0)
      (Fixed 0)
      (let (num (+ (* (fx-shr (- (v1 'x) (v2 'x)) 8) (v1 'dy))
                   (* (fx-shr (- (v2 'y) (v1 'y)) 8) (v1 'dx))))
        (/ num den)))))

;; The opening a two-sided line leaves, set by line-opening.

; Globals start at (Fixed 0): FIXED-ZERO is refused here. ISSUE-016
(defvar open-top:Fixed (Fixed 0))
(defvar open-bottom:Fixed (Fixed 0))
(defvar open-range:Fixed (Fixed 0))
(defvar low-floor:Fixed (Fixed 0))

(defn line-opening (ld:&Line):void
  (if (= (aref (ld 'side-num) 1) -1)
    (set! open-range (Fixed 0))
    (when-some (front (ld 'front-sector))
      (when-some (back (ld 'back-sector))
        (set! open-top (if (< (front 'ceiling-height) (back 'ceiling-height))
                         (front 'ceiling-height)
                         (back 'ceiling-height)))
        (if (> (front 'floor-height) (back 'floor-height))
          (do (set! open-bottom (front 'floor-height))
              (set! low-floor (back 'floor-height)))
          (do (set! open-bottom (back 'floor-height))
              (set! low-floor (front 'floor-height))))
        (set! open-range (- open-top open-bottom))))))

;; Thing links: each thing is in its sector's list and its blockmap cell's.

(defn block-x (x:Fixed):i32 (bit-shr ((- x bmap-org-x) 'v) MAPBLOCKSHIFT))
(defn block-y (y:Fixed):i32 (bit-shr ((- y bmap-org-y) 'v) MAPBLOCKSHIFT))

(defn- block-of (x:Fixed y:Fixed):i32
  (let (bx (block-x x) by (block-y y))
    (if (and (>= bx 0) (< bx bmap-width) (>= by 0) (< by bmap-height))
      (+ (* by bmap-width) bx)
      -1)))

; Unlinks a thing from its sector and blockmap lists, before it moves.
(defn unset-thing-position (thing:&Mobj):void
  (when (= (bit-and (thing 'flags) MF-NOSECTOR) 0)
    (when-some (n (thing 'snext)) (set! (n 'sprev) (thing 'sprev)))
    (if-some (p (thing 'sprev))
      (set! (p 'snext) (thing 'snext))
      (when-some (ss (thing 'subsector))
        (set! ((ss 'sector) 'thing-list) (thing 'snext)))))
  (when (= (bit-and (thing 'flags) MF-NOBLOCKMAP) 0)
    (when-some (n (thing 'bnext)) (set! (n 'bprev) (thing 'bprev)))
    (if-some (p (thing 'bprev))
      (set! (p 'bnext) (thing 'bnext))
      (let (b (block-of (thing 'x) (thing 'y)))
        (when (>= b 0) (set! ((blocklinks b) 'head) (thing 'bnext))))))) ; ISSUE-013

; Links a thing in at its current position, at the head of each list.
(defn set-thing-position (thing:&Mobj):void
  (let (ss (point-in-subsector (thing 'x) (thing 'y)))
    (set! (thing 'subsector) ss)
    (when (= (bit-and (thing 'flags) MF-NOSECTOR) 0)
      (let (sec (ss 'sector))
        (set! (thing 'sprev) null)
        (set! (thing 'snext) (sec 'thing-list))
        (when-some (h (sec 'thing-list)) (set! (h 'sprev) thing))
        (set! (sec 'thing-list) thing)))
    (when (= (bit-and (thing 'flags) MF-NOBLOCKMAP) 0)
      (let (b (block-of (thing 'x) (thing 'y)))
        (if (>= b 0)
          (let (link (blocklinks b)) ; ISSUE-013
            (set! (thing 'bprev) null)
            (set! (thing 'bnext) (link 'head))
            (when-some (h (link 'head)) (set! (h 'bprev) thing))
            (set! (link 'head) thing))
          (do (set! (thing 'bnext) null)
              (set! (thing 'bprev) null)))))))

;; Blockmap iterators. A callback returns false to stop; so does the iterator.

; The cell's line list from the lump, each line once per validcount. Every
; list starts with line 0, which vanilla checks like any other.
(defn block-lines-iterator (x:i32 y:i32 func:(fn bool)(&Line)):bool
  (if (or (< x 0) (< y 0) (>= x bmap-width) (>= y bmap-height))
    true
    (let (i (as i32 @(blockmap-lump (+ 4 (+ (* y bmap-width) x))))
          go true)
      (while (and go (!= @(blockmap-lump i) -1)) ; ISSUE-026
        (let (ld (lines (as i32 @(blockmap-lump i))))
          (when (!= (ld 'validcount) validcount)
            (set! (ld 'validcount) validcount)
            (when (not (func ld)) (set! go false))))
        (inc! i))
      go)))

(defn block-things-iterator (x:i32 y:i32 func:(fn bool)(&Mobj)):bool
  (if (or (< x 0) (< y 0) (>= x bmap-width) (>= y bmap-height))
    true
    (let (cur ((blocklinks (+ (* y bmap-width) x)) 'head) go true)
      (while (and go (not (null? cur))) ; ISSUE-026
        (when-some (m cur)
          ; Read the link first: the callback may unlink the thing.
          (set! cur (m 'bnext))
          (when (not (func m)) (set! go false))))
      go)))

;; Intercepts: the lines and things a trace crosses, visited nearest first.

(defstruct Intercept frac:Fixed line:?&Line thing:?&Mobj)

; Chocolate Doom's limit. Past vanilla's 128 it emulates the overrun into the
; globals that followed the array; no demo here reaches it, so this stops.
(defconst- MAXINTERCEPTS 189)
(defvar- intercepts:(array Intercept 189))
(defvar- intercept-count:i32 0)

(defvar trace:Divline (Divline (Fixed 0) (Fixed 0) (Fixed 0) (Fixed 0)))
(defvar- early-out:bool false)

(defn- add-intercept (frac:Fixed line:?&Line thing:?&Mobj):void
  (when (= intercept-count MAXINTERCEPTS) (fatal "intercepts overflow"))
  (set! (aref intercepts intercept-count) (Intercept frac line thing))
  (inc! intercept-count))

(defn- add-line-intercepts (ld:&Line):bool
  (let (big (or (> ((trace 'dx) 'v) (* FRAC-UNIT 16)) (> ((trace 'dy) 'v) (* FRAC-UNIT 16))
                (< ((trace 'dx) 'v) (* FRAC-UNIT -16)) (< ((trace 'dy) 'v) (* FRAC-UNIT -16)))
        s1 (if big
             (point-on-divline-side ((ld 'v1) 'x) ((ld 'v1) 'y) &trace)
             (point-on-line-side (trace 'x) (trace 'y) ld))
        s2 (if big
             (point-on-divline-side ((ld 'v2) 'x) ((ld 'v2) 'y) &trace)
             (point-on-line-side (+ (trace 'x) (trace 'dx)) (+ (trace 'y) (trace 'dy)) ld)))
    (if (= s1 s2)
      true
      (let (dl:Divline (divline-of ld)
            frac (intercept-vector &trace &dl))
        (cond (< (frac 'v) 0) true
          (and early-out (< (frac 'v) FRAC-UNIT) (null? (ld 'back-sector))) false
          true (do (add-intercept frac ld null) true))))))

(defn- add-thing-intercepts (thing:&Mobj):bool
  (let (positive (> (bit-xor ((trace 'dx) 'v) ((trace 'dy) 'v)) 0)
        r (thing 'radius)
        x1 (- (thing 'x) r)
        y1 (if positive (+ (thing 'y) r) (- (thing 'y) r))
        x2 (+ (thing 'x) r)
        y2 (if positive (- (thing 'y) r) (+ (thing 'y) r))
        s1 (point-on-divline-side x1 y1 &trace)
        s2 (point-on-divline-side x2 y2 &trace))
    (if (= s1 s2)
      true
      (let (dl:Divline (Divline x1 y1 (- x2 x1) (- y2 y1))
            frac (intercept-vector &trace &dl))
        (when (>= (frac 'v) 0) (add-intercept frac null thing))
        true))))

; Visits the intercepts nearest first, up to maxfrac; a visited one is pushed
; out of reach rather than removed, as the C does.
(defn- traverse-intercepts (func:(fn bool)(&Intercept) maxfrac:Fixed):bool
  (let (count intercept-count result true going true)
    (while (and going (> count 0)) ; ISSUE-026
      (set! count (- count 1))
      (let (dist:i32 2147483647 in:i32 0)
        (dotimes (i intercept-count)
          (when (< ((&(aref intercepts i) 'frac) 'v) dist)
            (set! dist ((&(aref intercepts i) 'frac) 'v))
            (set! in i)))
        (cond (> dist (maxfrac 'v)) (set! going false)
          (not (func &(aref intercepts in))) (do (set! result false) (set! going false))
          true (set! (&(aref intercepts in) 'frac) (Fixed 2147483647)))))
    result))

; Walks the blockmap cells along (x1,y1)-(x2,y2), collecting what the flags ask
; for, then hands the intercepts to `trav` in order.
(defn path-traverse (x1:Fixed y1:Fixed x2:Fixed y2:Fixed flags:i32 trav:(fn bool)(&Intercept)):bool
  (set! early-out (!= (bit-and flags PT-EARLYOUT) 0))
  (inc! validcount)
  (set! intercept-count 0)
  ; Don't start exactly on a block line.
  (when (= (bit-and ((- x1 bmap-org-x) 'v) (- MAPBLOCKSIZE 1)) 0) (set! x1 (+ x1 FIXED-ONE)))
  (when (= (bit-and ((- y1 bmap-org-y) 'v) (- MAPBLOCKSIZE 1)) 0) (set! y1 (+ y1 FIXED-ONE)))
  (set! trace (Divline x1 y1 (- x2 x1) (- y2 y1)))
  (let (ax1 ((- x1 bmap-org-x) 'v) ay1 ((- y1 bmap-org-y) 'v)
        ax2 ((- x2 bmap-org-x) 'v) ay2 ((- y2 bmap-org-y) 'v)
        xt1 (bit-shr ax1 MAPBLOCKSHIFT) yt1 (bit-shr ay1 MAPBLOCKSHIFT)
        xt2 (bit-shr ax2 MAPBLOCKSHIFT) yt2 (bit-shr ay2 MAPBLOCKSHIFT)
        mapxstep:i32 0 mapystep:i32 0
        partial:i32 0
        xstep:Fixed (Fixed 0) ystep:Fixed (Fixed 0))
    (cond (> xt2 xt1)
      (do (set! mapxstep 1)
          (set! partial (- FRAC-UNIT (bit-and (bit-shr ax1 MAPBTOFRAC) (- FRAC-UNIT 1))))
          (set! ystep (/ (Fixed (- ay2 ay1)) (fx-abs (Fixed (- ax2 ax1))))))
      (< xt2 xt1)
      (do (set! mapxstep -1)
          (set! partial (bit-and (bit-shr ax1 MAPBTOFRAC) (- FRAC-UNIT 1)))
          (set! ystep (/ (Fixed (- ay2 ay1)) (fx-abs (Fixed (- ax2 ax1))))))
      true
      (do (set! partial FRAC-UNIT)
          (set! ystep (Fixed (* 256 FRAC-UNIT)))))
    (let (yintercept (+ (Fixed (bit-shr ay1 MAPBTOFRAC)) (* (Fixed partial) ystep)))
      (cond (> yt2 yt1)
        (do (set! mapystep 1)
            (set! partial (- FRAC-UNIT (bit-and (bit-shr ay1 MAPBTOFRAC) (- FRAC-UNIT 1))))
            (set! xstep (/ (Fixed (- ax2 ax1)) (fx-abs (Fixed (- ay2 ay1))))))
        (< yt2 yt1)
        (do (set! mapystep -1)
            (set! partial (bit-and (bit-shr ay1 MAPBTOFRAC) (- FRAC-UNIT 1)))
            (set! xstep (/ (Fixed (- ax2 ax1)) (fx-abs (Fixed (- ay2 ay1))))))
        true
        (do (set! partial FRAC-UNIT)
            (set! xstep (Fixed (* 256 FRAC-UNIT)))))
      (let (xintercept (+ (Fixed (bit-shr ax1 MAPBTOFRAC)) (* (Fixed partial) xstep))
            mapx xt1 mapy yt1 count:i32 0 stopped false done false)
        (while (and (< count 64) (not stopped) (not done)) ; ISSUE-026
          (when (and (!= (bit-and flags PT-ADDLINES) 0)
                     (not (block-lines-iterator mapx mapy add-line-intercepts)))
            (set! stopped true))
          (when (and (not stopped) (!= (bit-and flags PT-ADDTHINGS) 0)
                     (not (block-things-iterator mapx mapy add-thing-intercepts)))
            (set! stopped true))
          (when (not stopped)
            (if (and (= mapx xt2) (= mapy yt2))
              (set! done true)
              (cond (= (fx-int yintercept) mapy)
                (do (set! yintercept (+ yintercept ystep))
                    (set! mapx (+ mapx mapxstep)))
                (= (fx-int xintercept) mapx)
                (do (set! xintercept (+ xintercept xstep))
                    (set! mapy (+ mapy mapystep))))))
          (inc! count))
        (if stopped
          false
          (traverse-intercepts trav FIXED-ONE))))))
