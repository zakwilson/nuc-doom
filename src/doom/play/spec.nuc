;; Finding neighbours.

; The sector across a two-sided line from `sec`, or null.
(defn next-sector (line:&Line sec:&Sector):?&Sector
  (cond (= (bit-and (line 'flags) ML-TWOSIDED) 0) null
    (= (unsafe/cast ptr (line 'front-sector)) (unsafe/cast ptr sec)) (line 'back-sector)
    true (line 'front-sector)))

(defn find-lowest-floor-surrounding (sec:&Sector):Fixed
  (let (floor (sec 'floor-height))
    (dotimes (i (sec 'line-count))
      (when-some (other (next-sector (sector-line sec i) sec))
        (when (< (other 'floor-height) floor) (set! floor (other 'floor-height)))))
    floor))

(defn find-highest-floor-surrounding (sec:&Sector):Fixed
  (let (floor:Fixed (Fixed (* -500 FRAC-UNIT))) ; ISSUE-025
    (dotimes (i (sec 'line-count))
      (when-some (other (next-sector (sector-line sec i) sec))
        (when (> (other 'floor-height) floor) (set! floor (other 'floor-height)))))
    floor))

(defconst- MAX-ADJOINING-SECTORS 20)

; The lowest neighbouring floor above `current`. Vanilla kept them in a
; 20-entry array; the 22nd overran into `height`, which Chocolate Doom
; emulates.
(defn find-next-highest-floor (sec:&Sector current:Fixed):Fixed
  (let (height current h:i32 0 min:?i32 none)
    (dotimes (i (sec 'line-count))
      (when-some (other (next-sector (sector-line sec i) sec))
        (when (> (other 'floor-height) height)
          (cond (= h (+ MAX-ADJOINING-SECTORS 1)) (set! height (other 'floor-height))
            (= h (+ MAX-ADJOINING-SECTORS 2))
            (fatal "Sector with more than 22 adjoining sectors. Vanilla will crash here"))
          (match min
            ((some m) (when (< ((other 'floor-height) 'v) m) (set! min (some ((other 'floor-height) 'v)))))
            (none (set! min (some ((other 'floor-height) 'v)))))
          (inc! h))))
    (match min ((some m) (Fixed m)) (none current))))

(defn find-lowest-ceiling-surrounding (sec:&Sector):Fixed
  (let (height FIXED-MAX)
    (dotimes (i (sec 'line-count))
      (when-some (other (next-sector (sector-line sec i) sec))
        (when (< (other 'ceiling-height) height) (set! height (other 'ceiling-height)))))
    height))

(defn find-highest-ceiling-surrounding (sec:&Sector):Fixed
  (let (height:Fixed (Fixed 0)) ; ISSUE-025
    (dotimes (i (sec 'line-count))
      (when-some (other (next-sector (sector-line sec i) sec))
        (when (> (other 'ceiling-height) height) (set! height (other 'ceiling-height)))))
    height))

; The next sector after `start` with the line's tag, or -1.
(defn find-sector-from-line-tag (line:&Line start:i32):i32
  (let (i (+ start 1) n (table-len sectors))
    (while (and (< i n) (!= ((sectors i) 'tag) (line 'tag))) (inc! i))
    (if (< i n) i -1)))

(defn find-min-surrounding-light (sec:&Sector max:i32):i32
  (let (min max)
    (dotimes (i (sec 'line-count))
      (when-some (check (next-sector (sector-line sec i) sec))
        (when (< (check 'light-level) min) (set! min (check 'light-level)))))
    min))

;; Animated flats and textures.

(defstruct Anim is-texture:bool pic-num:i32 base-pic:i32 num-pics:i32 speed:i32)

(defvar- anims:(array Anim 32))
(defvar- num-anims:i32 0)

; Skipped when the IWAD lacks the start frame (shareware lacks some).
(defn- add-anim (is-texture:bool end-name:StrView start-name:StrView speed:i32):void
  (when (if is-texture
          (= (check-texture-num-for-key (lump-key start-name)) -1)
          (= (check-num-for-name start-name) -1))
    (return))
  (let (a &(aref anims num-anims))
    (set! (a 'is-texture) is-texture)
    (if is-texture
      (do (set! (a 'pic-num) (texture-num-for-name end-name))
          (set! (a 'base-pic) (texture-num-for-name start-name)))
      (do (set! (a 'pic-num) (flat-num-for-name end-name))
          (set! (a 'base-pic) (flat-num-for-name start-name))))
    (set! (a 'num-pics) (+ (- (a 'pic-num) (a 'base-pic)) 1))
    (when (< (a 'num-pics) 2) (fatal "P_InitPicAnims: bad cycle"))
    (set! (a 'speed) speed)
    (inc! num-anims)))

(defn- init-pic-anims ():void
