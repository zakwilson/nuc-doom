;
; Things (p_mobj.c, and the position links from p_maputl.c): spawning, and
; linking each thing into its sector's and blockmap cell's lists.

(ns doom.play.mobj)

(import-use nucleus.create)
(import-use doom.math)
(import-use doom.defs)
(import-use doom.info)
(import-use doom.table)
(import-use doom.system)
(import-use doom.random)
(import-use doom.world)
(import-use doom.state)
(import-use doom.geom)
(import-use doom.play.tick)
(import-use doom.play.setup)
(import-use doom.play.pspr)
(import-use doom.game)

(defn mobj-info-of (m:&Mobj):&MobjInfo &(aref mobj-info (m 'type)))

(defn- block-of (x:Fixed y:Fixed):i32
  (let (bx (bit-shr ((- x bmap-org-x) 'v) MAPBLOCKSHIFT)
        by (bit-shr ((- y bmap-org-y) 'v) MAPBLOCKSHIFT))
    (if (and (>= bx 0) (< bx bmap-width) (>= by 0) (< by bmap-height))
      (+ (* by bmap-width) bx)
      -1)))

; Unlinks a thing from its sector and blockmap lists, before it moves.
(defn unset-thing-position (thing:&Mobj):void
  (when (= (bit-and (thing 'flags) MF-NOSECTOR) 0)
    (when-some (n (thing 'snext)) (set! (n 'sprev) (thing 'sprev)))
    (if-some (p (thing 'sprev))
      (set! (p 'snext) (thing 'snext))
      (when-some (ss (thing 'subsector))
        (set! ((ss 'sector) 'thing-list) (thing 'snext)))))
  (when (= (bit-and (thing 'flags) MF-NOBLOCKMAP) 0)
    (when-some (n (thing 'bnext)) (set! (n 'bprev) (thing 'bprev)))
    (if-some (p (thing 'bprev))
      (set! (p 'bnext) (thing 'bnext))
      (let (b (block-of (thing 'x) (thing 'y)))
        (when (>= b 0) (set! ((blocklinks b) 'head) (thing 'bnext))))))) ; ISSUE-013

; Links a thing in at its current position, at the head of each list.
(defn set-thing-position (thing:&Mobj):void
  (let (ss (point-in-subsector (thing 'x) (thing 'y)))
    (set! (thing 'subsector) ss)
    (when (= (bit-and (thing 'flags) MF-NOSECTOR) 0)
      (let (sec (ss 'sector))
        (set! (thing 'sprev) null)
        (set! (thing 'snext) (sec 'thing-list))
        (when-some (h (sec 'thing-list)) (set! (h 'sprev) thing))
        (set! (sec 'thing-list) thing)))
    (when (= (bit-and (thing 'flags) MF-NOBLOCKMAP) 0)
      (let (b (block-of (thing 'x) (thing 'y)))
        (if (>= b 0)
          (let (link (blocklinks b)) ; ISSUE-013
            (set! (thing 'bprev) null)
            (set! (thing 'bnext) (link 'head))
            (when-some (h (link 'head)) (set! (h 'bprev) thing))
            (set! (link 'head) thing))
          (do (set! (thing 'bnext) null)
              (set! (thing 'bprev) null)))))))

(defn spawn-mobj (x:Fixed y:Fixed z:Fixed type:i32):&Mobj
  (let (m (new Mobj level-arena)
        info &(aref mobj-info type)
        st &(aref states (info 'spawn-state)))
    (set! (m 'type) type)
    (set! (m 'x) x)
    (set! (m 'y) y)
    (set! (m 'radius) (info 'radius))
    (set! (m 'height) (info 'height))
    (set! (m 'flags) (info 'flags))
    (set! (m 'health) (info 'spawn-health))
    (when (!= game-skill SK-NIGHTMARE)
      (set! (m 'reaction-time) (info 'reaction-time)))
    (set! (m 'last-look) (% (p-random) MAX-PLAYERS))
    (set! (m 'state) (info 'spawn-state))
    (set! (m 'tics) (st 'tics))
    (set! (m 'sprite) (st 'sprite))
    (set! (m 'frame) (st 'frame))
    (set-thing-position m)
    (when-some (ss (m 'subsector))
      (set! (m 'floorz) ((ss 'sector) 'floor-height))
      (set! (m 'ceilingz) ((ss 'sector) 'ceiling-height)))
    (set! (m 'z) (cond (= (z 'v) ONFLOORZ) (m 'floorz)
                   (= (z 'v) ONCEILINGZ) (- (m 'ceilingz) (info 'height))
                   true z))
    (add-thinker &(m 'th) (Thinker-mobj m))
    m))

(defn- spawn-player (mt:MapThing):void
  (when (and (!= (mt 'type) 0) (aref player-in-game (- (mt 'type) 1)))
    (let (pn (- (mt 'type) 1)
          p (player pn))
      (when (= (p 'player-state) PST-REBORN) (player-reborn pn))
      (let (m (spawn-mobj (fx (mt 'x)) (fx (mt 'y)) (Fixed ONFLOORZ) MT-PLAYER))
        ; Players 2-4 are drawn with their colour remapped.
        (when (> (mt 'type) 1)
          (set! (m 'flags) (bit-or (m 'flags) (bit-shl (- (mt 'type) 1) MF-TRANSSHIFT))))
        (set! (m 'angle) (* ANG45 (unsafe/cast ui32 (/ (mt 'angle) 45))))
        (set! (m 'player) p)
        (set! (m 'health) (p 'health))
        (set! (p 'mo) m)
        (set! (p 'player-state) PST-LIVE)
        (set! (p 'refire) 0)
        (set! (p 'message) null)
        (set! (p 'damage-count) 0)
        (set! (p 'bonus-count) 0)
        (set! (p 'extra-light) 0)
        (set! (p 'fixed-colormap) 0)
        (set! (p 'view-height) (Fixed VIEWHEIGHT))
        (setup-psprites p)
        (when (!= deathmatch 0)
          (dotimes (i NUM-CARDS) (set! (aref (p 'cards) i) true)))))))

(defn spawn-map-thing (mt:MapThing):void
  (cond (= (mt 'type) 11) (when (< deathmatch-count 10)
       (set! (aref deathmatch-starts deathmatch-count) mt)
       (inc! deathmatch-count))
    (<= (mt 'type) 0) (do)
    (<= (mt 'type) 4) (do (set! (aref player-starts (- (mt 'type) 1)) mt) (set! (aref player-start-in-game (- (mt 'type) 1)) true) (when (= deathmatch 0) (spawn-player mt)))
    (and (not netgame) (!= (bit-and (mt 'options) 16) 0)) (do)
    true (let (bit (cond (= game-skill SK-BABY) 1
            (= game-skill SK-NIGHTMARE) 4
            true (bit-shl 1 (bit-and (- game-skill 1) 31)))
           i:i32 0)
       (when (!= (bit-and (mt 'options) bit) 0)
         (while (and (< i NUM-MOBJ-TYPES) (!= (mt 'type) ((aref mobj-info i) 'doomed-num)))
           (inc! i))
         (when (= i NUM-MOBJ-TYPES) (fatal "P_SpawnMapThing: Unknown type"))
         (let (info &(aref mobj-info i))
           (when (not (or (and (!= deathmatch 0) (!= (bit-and (info 'flags) MF-NOTDMATCH) 0))
                          (and nomonsters (or (= i MT-SKULL) (!= (bit-and (info 'flags) MF-COUNTKILL) 0)))))
             (let (m (spawn-mobj (fx (mt 'x)) (fx (mt 'y))
                                 (Fixed (if (!= (bit-and (info 'flags) MF-SPAWNCEILING) 0) ONCEILINGZ ONFLOORZ))
                                 i))
               (set! (m 'spawn-point) mt)
               (when (> (m 'tics) 0)
                 (set! (m 'tics) (+ 1 (% (p-random) (m 'tics)))))
               (when (!= (bit-and (m 'flags) MF-COUNTKILL) 0) (inc! total-kills))
               (when (!= (bit-and (m 'flags) MF-COUNTITEM) 0) (inc! total-items))
               (set! (m 'angle) (* ANG45 (unsafe/cast ui32 (/ (mt 'angle) 45))))
               (when (!= (bit-and (mt 'options) MTF-AMBUSH) 0)
                 (set! (m 'flags) (bit-or (m 'flags) MF-AMBUSH))))))))))
