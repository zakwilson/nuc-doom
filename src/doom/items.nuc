;
; What each weapon fires and its sprite states (d_items.c). Its own module so
; that it sits outside the playsim's import cycle, which an aggregate defconst
; can't cross. ISSUE-024

(ns doom.items)

(import-use doom.defs)
(import-use doom.info)

(defstruct WeaponInfo ammo:i32 up-state:i32 down-state:i32 ready-state:i32 atk-state:i32 flash-state:i32)

(defconst weapon-info
  (array WeaponInfo
    (WeaponInfo AM-NOAMMO S-PUNCHUP S-PUNCHDOWN S-PUNCH S-PUNCH1 S-NULL)
    (WeaponInfo AM-CLIP S-PISTOLUP S-PISTOLDOWN S-PISTOL S-PISTOL1 S-PISTOLFLASH)
    (WeaponInfo AM-SHELL S-SGUNUP S-SGUNDOWN S-SGUN S-SGUN1 S-SGUNFLASH1)
    (WeaponInfo AM-CLIP S-CHAINUP S-CHAINDOWN S-CHAIN S-CHAIN1 S-CHAINFLASH1)
    (WeaponInfo AM-MISL S-MISSILEUP S-MISSILEDOWN S-MISSILE S-MISSILE1 S-MISSILEFLASH1)
    (WeaponInfo AM-CELL S-PLASMAUP S-PLASMADOWN S-PLASMA S-PLASMA1 S-PLASMAFLASH1)
    (WeaponInfo AM-CELL S-BFGUP S-BFGDOWN S-BFG S-BFG1 S-BFGFLASH1)
    (WeaponInfo AM-NOAMMO S-SAWUP S-SAWDOWN S-SAW S-SAW1 S-NULL)
    (WeaponInfo AM-SHELL S-DSGUNUP S-DSGUNDOWN S-DSGUN S-DSGUN1 S-DSGUNFLASH1)))
