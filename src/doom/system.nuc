;
; I_Error: the conditions the C treats as fatal stay fatal here. Errors a
; caller can act on (a missing lump, a bad WAD) are Results instead.

(ns doom.system)

(import-use "stdio.h")
(import-use "stdlib.h")

(extern stderr:ptr) ; ISSUE-006

(defn fatal (msg:StrView):void
  (fprintf stderr "nuc-doom: %.*s\n" (unsafe/cast i32 (msg 'len)) (msg 'data))
  (exit 1))
