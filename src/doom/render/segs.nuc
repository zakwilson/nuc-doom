;
; Walls (r_segs.c): draw a seg's visible span column by column, mark the
; floor and ceiling rows around it, and record it for sprite clipping.

(ns doom.render.segs)

(import-use doom.math)
(import-use doom.world)
(import-use doom.defs)
(import-use doom.system)
(import-use doom.render.main)
(import-use doom.render.data)
(import-use doom.render.draw)
(import-use doom.render.bsp)
(import-use doom.render.plane)
(import-use doom.render.things)

(defconst- HEIGHTBITS 12)
(defconst- HEIGHTUNIT 4096)
(defconst- SHRT-MAX 32767)

(defvar- seg-textured:bool false)
(defvar- mark-floor:bool false)
(defvar- mark-ceiling:bool false)
(defvar- masked-texture:bool false)
(defvar- top-texture:i32 0)
(defvar- bottom-texture:i32 0)
(defvar- mid-texture:i32 0)

(defvar- rw-normal-angle:Angle 0)
(defvar- rw-x:i32 0)
(defvar- rw-stop-x:i32 0)
(defvar- rw-center-angle:Angle 0)
; Globals start at (Fixed 0): FIXED-ZERO is refused here. ISSUE-016
(defvar- rw-offset:Fixed (Fixed 0))
(defvar- rw-distance:Fixed (Fixed 0))
(defvar- rw-scale:Fixed (Fixed 0))
(defvar- rw-scale-step:Fixed (Fixed 0))
(defvar- rw-mid-texture-mid:Fixed (Fixed 0))
(defvar- rw-top-texture-mid:Fixed (Fixed 0))
(defvar- rw-bottom-texture-mid:Fixed (Fixed 0))

; Heights relative to the eye, in 20.12 once the column loop starts.
(defvar- world-top:i32 0)
(defvar- world-bottom:i32 0)
(defvar- world-high:i32 0)
(defvar- world-low:i32 0)

(defvar- pix-high:i32 0)
(defvar- pix-low:i32 0)
(defvar- pix-high-step:i32 0)
(defvar- pix-low-step:i32 0)
(defvar- top-frac:i32 0)
(defvar- top-step:i32 0)
(defvar- bottom-frac:i32 0)
(defvar- bottom-step:i32 0)

; The scale-light row for this wall's light.
(defvar- wall-lights:i32 0)
(defvar- masked-texture-col:i32 NO-CLIP)

(defn- wall-colormap (scale:Fixed):i32
  (if (!= fixed-colormap 0)
    fixed-colormap
    (scale-light-map wall-lights (bit-shr (scale 'v) LIGHTSCALESHIFT))))

; Light varies with a wall's direction: east-west walls are a step darker
; and north-south ones a step lighter, for fake contrast.
(defn- seg-light-row (line:&Seg sector:&Sector):i32
  (let (light (+ (bit-shr (sector 'light-level) LIGHTSEGSHIFT) extra-light))
    (cond (= ((line 'v1) 'y) ((line 'v2) 'y)) (light-row (- light 1))
      (= ((line 'v1) 'x) ((line 'v2) 'x)) (light-row (+ light 1))
      true (light-row light))))

(defn- inverse-scale (scale:Fixed):Fixed
  (Fixed (unsafe/cast i32 (/ 0xffffffff (unsafe/cast ui32 (scale 'v))))))

(defn render-masked-seg-range (ds:&DrawSeg x1:i32 x2:i32):void
  (let (line (segs (ds 'cur-line))
        front (line 'front-sector)
        tex @(texture-translation ((line 'side-def) 'mid-texture)))
    (if-some (back (line 'back-sector))
      (let (mid (+ (if (!= (bit-and ((line 'line-def) 'flags) ML-DONTPEGBOTTOM) 0)
                     (- (+ (if (> (front 'floor-height) (back 'floor-height))
                             (front 'floor-height) (back 'floor-height))
                           (texture-height tex))
                        view-z)
                     (- (if (< (front 'ceiling-height) (back 'ceiling-height))
                          (front 'ceiling-height) (back 'ceiling-height))
                        view-z))
                   ((line 'side-def) 'row-offset))
            col (ds 'masked-texture-col))
        (set! wall-lights (seg-light-row line front))
        (set! rw-scale-step (ds 'scale-step))
        (set! spry-scale (+ (ds 'scale1) (* rw-scale-step (- x1 (ds 'x1)))))
        (set! mfloor-clip (ds 'spr-bottom-clip))
        (set! mceiling-clip (ds 'spr-top-clip))
        (let (x x1)
          (while (<= x x2)
            (when (!= (clip-at col x) SHRT-MAX)
              (set! spr-top-screen (- center-y-frac (* mid spry-scale)))
              (let (c (Column x 0 0 (inverse-scale spry-scale) mid
                              (texture-column tex (clip-at col x))
                              (wall-colormap spry-scale) 0))
                ; The texture column starts three bytes into a post.
                (draw-masked-column c (unsafe/ptr+ (c 'source) -3) COL-NORMAL))
              (set-clip col x SHRT-MAX))
            (set! spry-scale (+ spry-scale rw-scale-step))
            (inc! x))))
      (fatal "R_RenderMaskedSegRange: one-sided masked seg"))))

(defn- draw-wall-column (x:i32 yl:i32 yh:i32 mid:Fixed tex:i32 col:i32 cmap:i32 iscale:Fixed):void
  (let (c (Column x yl yh iscale mid (texture-column tex col) cmap 0))
    (draw-column COL-NORMAL c)))

(defn- render-seg-loop ():void
  (while (< rw-x rw-stop-x)
    (let (x rw-x
          cclip (as i32 (aref ceiling-clip x))
          fclip (as i32 (aref floor-clip x))
          yl (bit-shr (- (+ top-frac HEIGHTUNIT) 1) HEIGHTBITS)
          yh (bit-shr bottom-frac HEIGHTBITS)
          texcol:i32 0
          cmap:i32 0
          iscale:Fixed (Fixed 0))
      (when (< yl (+ cclip 1)) (set! yl (+ cclip 1)))
      (when mark-ceiling
        (let (top (+ cclip 1) bottom (- yl 1))
          (when (>= bottom fclip) (set! bottom (- fclip 1)))
          (when (<= top bottom)
            (let (pl (visplane ceiling-plane))
              (set-plane-top pl x top)
              (set-plane-bottom pl x bottom)))))
      (when (>= yh fclip) (set! yh (- fclip 1)))
      (when mark-floor
        (let (top (+ yh 1) bottom (- fclip 1))
          (when (<= top cclip) (set! top (+ cclip 1)))
          (when (<= top bottom)
            (let (pl (visplane floor-plane))
              (set-plane-top pl x top)
              (set-plane-bottom pl x bottom)))))
      (when seg-textured
        (let (angle (fine-index (+ rw-center-angle (x-angle x))))
          (set! texcol (fx-int (- rw-offset (* (fine-tangent angle) rw-distance))))
          (set! cmap (wall-colormap rw-scale))
          (set! iscale (inverse-scale rw-scale))))
      (if (!= mid-texture 0)
        (do (draw-wall-column x yl yh rw-mid-texture-mid mid-texture texcol cmap iscale)
            (set! (aref ceiling-clip x) view-height)
            (set! (aref floor-clip x) -1))
        (do
          (if (!= top-texture 0)
            (let (mid (bit-shr pix-high HEIGHTBITS))
              (set! pix-high (+ pix-high pix-high-step))
              (when (>= mid fclip) (set! mid (- fclip 1)))
              (if (>= mid yl)
                (do (draw-wall-column x yl mid rw-top-texture-mid top-texture texcol cmap iscale)
                    (set! (aref ceiling-clip x) mid))
                (set! (aref ceiling-clip x) (- yl 1))))
            (when mark-ceiling (set! (aref ceiling-clip x) (- yl 1))))
          (if (!= bottom-texture 0)
            (let (mid (bit-shr (- (+ pix-low HEIGHTUNIT) 1) HEIGHTBITS))
              (set! pix-low (+ pix-low pix-low-step))
              (when (<= mid (as i32 (aref ceiling-clip x))) (set! mid (+ (as i32 (aref ceiling-clip x)) 1)))
              (if (<= mid yh)
                (do (draw-wall-column x mid yh rw-bottom-texture-mid bottom-texture texcol cmap iscale)
                    (set! (aref floor-clip x) mid))
                (set! (aref floor-clip x) (+ yh 1))))
            (when mark-floor (set! (aref floor-clip x) (+ yh 1))))
          (when masked-texture
            (set-clip masked-texture-col x texcol))))
      (set! rw-scale (+ rw-scale rw-scale-step))
      (set! top-frac (+ top-frac top-step))
      (set! bottom-frac (+ bottom-frac bottom-step))
      (inc! rw-x))))

(defn- iabs (x:i32):i32 (if (< x 0) (- 0 x) x))

; Draws seg cur-line over columns [start, stop] and records a drawseg.
(defn store-wall-range (start:i32 stop:i32):void
  (when (< ds-count MAXDRAWSEGS)
    (when (or (>= start view-width) (> start stop))
      (fatal "Bad R_RenderWallRange"))
    (let (ds (draw-seg ds-count)
          line (segs cur-line)
          side (line 'side-def)
          linedef (line 'line-def)
          front front-sector
          hyp:Fixed (Fixed 0))
      (set! (linedef 'flags) (bit-or (linedef 'flags) ML-MAPPED))
      (set! rw-normal-angle (+ (line 'angle) ANG90))
      (let (offsetangle (unsafe/cast ui32 (iabs (- (unsafe/cast i32 rw-normal-angle) (unsafe/cast i32 rw-angle1)))))
        (when (> offsetangle ANG90) (set! offsetangle ANG90))
        (set! hyp (point-to-dist ((line 'v1) 'x) ((line 'v1) 'y)))
        (set! rw-distance (* hyp (fine-sine (fine-index (- ANG90 offsetangle))))))
      (set! rw-x start)
      (set! (ds 'x1) start)
      (set! (ds 'x2) stop)
      (set! (ds 'cur-line) cur-line)
      (set! rw-stop-x (+ stop 1))
      (set! rw-scale (scale-from-global-angle (+ view-angle (x-angle start)) rw-normal-angle rw-distance))
      (set! (ds 'scale1) rw-scale)
      (if (> stop start)
        (do (set! (ds 'scale2) (scale-from-global-angle (+ view-angle (x-angle stop)) rw-normal-angle rw-distance))
            (set! rw-scale-step (/ (- (ds 'scale2) rw-scale) (- stop start)))
            (set! (ds 'scale-step) rw-scale-step))
        (set! (ds 'scale2) (ds 'scale1)))
      (set! world-top ((- (front 'ceiling-height) view-z) 'v))
      (set! world-bottom ((- (front 'floor-height) view-z) 'v))
      (set! mid-texture 0)
      (set! top-texture 0)
      (set! bottom-texture 0)
      (set! masked-texture false)
      (set! (ds 'masked-texture-col) NO-CLIP)
      (if-some (back back-sector)
        (do
          (set! (ds 'spr-top-clip) NO-CLIP)
          (set! (ds 'spr-bottom-clip) NO-CLIP)
          (set! (ds 'silhouette) SIL-NONE)
          (cond (> (front 'floor-height) (back 'floor-height)) (do (set! (ds 'silhouette) SIL-BOTTOM) (set! (ds 'bsil-height) (front 'floor-height)))
            (> (back 'floor-height) view-z) (do (set! (ds 'silhouette) SIL-BOTTOM) (set! (ds 'bsil-height) FIXED-MAX)))
          (cond (< (front 'ceiling-height) (back 'ceiling-height)) (do (set! (ds 'silhouette) (bit-or (ds 'silhouette) SIL-TOP)) (set! (ds 'tsil-height) (front 'ceiling-height)))
            (< (back 'ceiling-height) view-z) (do (set! (ds 'silhouette) (bit-or (ds 'silhouette) SIL-TOP)) (set! (ds 'tsil-height) FIXED-MIN)))
          (when (<= (back 'ceiling-height) (front 'floor-height))
            (set! (ds 'spr-bottom-clip) CLIP-NEG-ONE)
            (set! (ds 'bsil-height) FIXED-MAX)
            (set! (ds 'silhouette) (bit-or (ds 'silhouette) SIL-BOTTOM)))
          (when (>= (back 'floor-height) (front 'ceiling-height))
            (set! (ds 'spr-top-clip) CLIP-SCREEN-HEIGHT)
            (set! (ds 'tsil-height) FIXED-MIN)
            (set! (ds 'silhouette) (bit-or (ds 'silhouette) SIL-TOP)))
          (set! world-high ((- (back 'ceiling-height) view-z) 'v))
          (set! world-low ((- (back 'floor-height) view-z) 'v))
          ; Sky above both sides: the upper wall is sky too, so don't draw it.
          (when (and (= (front 'ceiling-pic) sky-flat-num) (= (back 'ceiling-pic) sky-flat-num))
            (set! world-top world-high))
          (set! mark-floor (or (!= world-low world-bottom)
                               (!= (back 'floor-pic) (front 'floor-pic))
                               (!= (back 'light-level) (front 'light-level))))
          (set! mark-ceiling (or (!= world-high world-top)
                                 (!= (back 'ceiling-pic) (front 'ceiling-pic))
                                 (!= (back 'light-level) (front 'light-level))))
          (when (or (<= (back 'ceiling-height) (front 'floor-height))
                    (>= (back 'floor-height) (front 'ceiling-height)))
            ; A closed door.
            (set! mark-ceiling true)
            (set! mark-floor true))
          (when (< world-high world-top)
            (set! top-texture @(texture-translation (side 'top-texture)))
            (set! rw-top-texture-mid
                  (if (!= (bit-and (linedef 'flags) ML-DONTPEGTOP) 0)
                    (Fixed world-top)
                    (- (+ (back 'ceiling-height) (texture-height (side 'top-texture))) view-z))))
          (when (> world-low world-bottom)
            (set! bottom-texture @(texture-translation (side 'bottom-texture)))
            (set! rw-bottom-texture-mid
                  (if (!= (bit-and (linedef 'flags) ML-DONTPEGBOTTOM) 0)
                    (Fixed world-top)
                    (Fixed world-low))))
          (set! rw-top-texture-mid (+ rw-top-texture-mid (side 'row-offset)))
          (set! rw-bottom-texture-mid (+ rw-bottom-texture-mid (side 'row-offset)))
          (when (!= (side 'mid-texture) 0)
            ; A masked wall: remember its columns for after the sprites.
            (set! masked-texture true)
            (set! masked-texture-col (- last-opening rw-x))
            (set! (ds 'masked-texture-col) masked-texture-col)
            (set! last-opening (+ last-opening (- rw-stop-x rw-x)))))
        (do
          ; One-sided: a solid wall.
          (set! mid-texture @(texture-translation (side 'mid-texture)))
          (set! mark-floor true)
          (set! mark-ceiling true)
          (set! rw-mid-texture-mid
                (+ (if (!= (bit-and (linedef 'flags) ML-DONTPEGBOTTOM) 0)
                     (- (+ (front 'floor-height) (texture-height (side 'mid-texture))) view-z)
                     (Fixed world-top))
                   (side 'row-offset)))
          (set! (ds 'silhouette) SIL-BOTH)
          (set! (ds 'spr-top-clip) CLIP-SCREEN-HEIGHT)
          (set! (ds 'spr-bottom-clip) CLIP-NEG-ONE)
          (set! (ds 'bsil-height) FIXED-MAX)
          (set! (ds 'tsil-height) FIXED-MIN)))
      (set! seg-textured (or (!= mid-texture 0) (!= top-texture 0) (!= bottom-texture 0) masked-texture))
      (when seg-textured
        (let (offsetangle (- rw-normal-angle rw-angle1))
          (when (> offsetangle ANG180) (set! offsetangle (- 0 offsetangle)))
          (when (> offsetangle ANG90) (set! offsetangle ANG90))
          (set! rw-offset (* hyp (fine-sine (fine-index offsetangle))))
          (when (< (- rw-normal-angle rw-angle1) ANG180) (set! rw-offset (fx-neg rw-offset)))
          (set! rw-offset (+ rw-offset (side 'texture-offset) (line 'offset)))
          (set! rw-center-angle (- (+ ANG90 view-angle) rw-normal-angle))
          (when (= fixed-colormap 0)
            (set! wall-lights (seg-light-row line front)))))
      ; Planes the eye is below or above can't be seen from this side.
      (when (>= (front 'floor-height) view-z) (set! mark-floor false))
      (when (and (<= (front 'ceiling-height) view-z) (!= (front 'ceiling-pic) sky-flat-num))
        (set! mark-ceiling false))
      (set! world-top (bit-shr world-top 4))
      (set! world-bottom (bit-shr world-bottom 4))
      (set! top-step (- 0 ((* rw-scale-step (Fixed world-top)) 'v)))
      (set! top-frac (- (bit-shr (center-y-frac 'v) 4) ((* (Fixed world-top) rw-scale) 'v)))
      (set! bottom-step (- 0 ((* rw-scale-step (Fixed world-bottom)) 'v)))
      (set! bottom-frac (- (bit-shr (center-y-frac 'v) 4) ((* (Fixed world-bottom) rw-scale) 'v)))
      (when (some? back-sector)
        (set! world-high (bit-shr world-high 4))
        (set! world-low (bit-shr world-low 4))
        (when (< world-high world-top)
          (set! pix-high (- (bit-shr (center-y-frac 'v) 4) ((* (Fixed world-high) rw-scale) 'v)))
          (set! pix-high-step (- 0 ((* rw-scale-step (Fixed world-high)) 'v))))
        (when (> world-low world-bottom)
          (set! pix-low (- (bit-shr (center-y-frac 'v) 4) ((* (Fixed world-low) rw-scale) 'v)))
          (set! pix-low-step (- 0 ((* rw-scale-step (Fixed world-low)) 'v)))))
      (when mark-ceiling (set! ceiling-plane (check-plane ceiling-plane rw-x (- rw-stop-x 1))))
      (when mark-floor (set! floor-plane (check-plane floor-plane rw-x (- rw-stop-x 1))))
      (render-seg-loop)
      ; Save the clip rows sprites behind this wall will need.
      (when (and (or (!= (bit-and (ds 'silhouette) SIL-TOP) 0) masked-texture)
                 (= (ds 'spr-top-clip) NO-CLIP))
        (dotimes (i (- rw-stop-x start))
          (set! (aref clip-store (+ last-opening i)) (aref ceiling-clip (+ start i))))
        (set! (ds 'spr-top-clip) (- last-opening start))
        (set! last-opening (+ last-opening (- rw-stop-x start))))
      (when (and (or (!= (bit-and (ds 'silhouette) SIL-BOTTOM) 0) masked-texture)
                 (= (ds 'spr-bottom-clip) NO-CLIP))
        (dotimes (i (- rw-stop-x start))
          (set! (aref clip-store (+ last-opening i)) (aref floor-clip (+ start i))))
        (set! (ds 'spr-bottom-clip) (- last-opening start))
        (set! last-opening (+ last-opening (- rw-stop-x start))))
      (when (and masked-texture (= (bit-and (ds 'silhouette) SIL-TOP) 0))
        (set! (ds 'silhouette) (bit-or (ds 'silhouette) SIL-TOP))
        (set! (ds 'tsil-height) FIXED-MIN))
      (when (and masked-texture (= (bit-and (ds 'silhouette) SIL-BOTTOM) 0))
        (set! (ds 'silhouette) (bit-or (ds 'silhouette) SIL-BOTTOM))
        (set! (ds 'bsil-height) FIXED-MAX))
      (inc! ds-count))))

(defn- some? (s:?&Sector):bool (not (null? s)))
