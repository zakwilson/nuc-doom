(ns tests.config)
(import-use nucleus.error)
(import-use nucleus.string)
(import-use nucleus.strview)
(import-use nucleus.test)
(import-use doom.event)
(import-use doom.hud)
(import-use doom.menu)
(import-use doom.config)

(deftest key-names-round-trip
  (dotimes (code 256)
    (with (n (key-name code))
      (when (not (strview-has-prefix (string-as-view &n) "#"))
        (match (key-code (string-as-view &n))
          ((some c) (try (check-eq-int (as i64 c) (as i64 code) (string-as-view &n))))
          (none (fail! "no code for " (string-as-view &n))))))))

; What the file says comes back, by name; what it leaves out keeps its value,
; and a value out of range is ignored.
(deftest config-round-trips
  (set! screen-blocks 10)
  (set! key-fire 102)
  (set! (aref key-weapons 7) KEY-F5)
  (set! show-messages false)
  (with (text (config-text))
    (try (check-contains (string-as-view &text) ":fire \"f\""))
    (try (check-contains (string-as-view &text) ":weapon8 \"f5\""))
    (set! screen-blocks 9)
    (set! key-fire KEY-RCTRL)
    (set! (aref key-weapons 7) 56)
    (set! show-messages true)
    (apply-config (string-as-view &text) "test"))
  (try (check-eq-int (as i64 screen-blocks) 10 "screen-blocks"))
  (try (check-eq-int (as i64 key-fire) 102 "fire"))
  (try (check-eq-int (as i64 (aref key-weapons 7)) (as i64 KEY-F5) "weapon8"))
  (try (check (not show-messages) "show-messages"))
  (apply-config "{:screen-blocks 40 :keys {:use \"ctrl\"}}" "test")
  (try (check-eq-int (as i64 screen-blocks) 10 "out of range kept"))
  (try (check-eq-int (as i64 key-use) (as i64 KEY-RCTRL) "use"))
  (try (check-eq-int (as i64 key-fire) 102 "absent kept")))
