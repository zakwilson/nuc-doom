; Where the tests find Chocolate Doom's sources and the IWAD: $CHOCOLATE_DOOM,
; else the sibling checkout this repo was set up beside.
(ns tests.env)
(import-use "stdlib.h")
(import-use nucleus.error)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use doom.wad)

(defn choc-path (rel:StrView):String
  (let (root:CStr (getenv "CHOCOLATE_DOOM"))
    (str (if (= root null) "/home/zak/code/chocolate-doom" (strview-from-cstr root)) "/" rel)))

(defvar iwad-loaded:bool false)

(defn ensure-iwad ():!void
  (when (not iwad-loaded)
    (let (p:String (choc-path "src/DOOM1.WAD"))
      (try (add-file (string-as-view &p))))
    (set! iwad-loaded true))
  (ok))
