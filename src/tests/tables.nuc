; The embedded tables must equal Chocolate Doom's, element for element (§6.1).
(ns tests.tables)
(import-use nucleus.error)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.fmt)
(import-use nucleus.vector)
(import-use nucleus.create)
(import-use nucleus.test)
(import-use doom.tables)
(import-use doom.math)
(import-use tests.env)

; The text from the `name[` that starts a definition: the one whose line has
; an `=`, since tables.c's header comment names every table first.
(defn- definition-at (src:StrView key:StrView):StrView
  (let (rest src)
    (while true
      (match (strview-find &rest &key) ; ISSUE-007
        ((some k)
         (let (from (strview-drop-bytes rest k)
               eol (match (strview-find-byte &from 10) ((some e) e) (none (from 'len)))
               line (strview-take-bytes from eol))
           (when (match (strview-find-byte &line 61) ((some _) true) (none false))
             (return from))
           (set! rest (strview-drop-bytes from 1))))
        (none (return (strview-drop-bytes src (src 'len))))))
    rest))

; The integers inside the braces after `name[` in a C source, nested rows flattened.
(defn c-table (src:StrView name:StrView):!(Vector i64)
  (let (out (make (Vector i64))
        key:String (str name "[")
        kv (string-as-view &key)
        rest (definition-at src kv)
        i:usize (match (strview-find-byte &rest 123) ((some k) k) (none (rest 'len))) ; ISSUE-007
        n:i64 0 neg false digits false depth 0)
    (while (< i (rest 'len))
      (let (c:ui8 (aref (rest 'data) i))
        (cond (= c 123) (inc! depth)
              (= c 125) (do (dec! depth) (when (= depth 0) (set! i (rest 'len))))
              (and (>= c 48) (<= c 57))
              (do (set! n (+ (* n 10) (as i64 (- c 48)))) (set! digits true))
              (= c 45) (set! neg true)
              true (do))
        (when (and digits (or (< c 48) (> c 57)))
          (conj &out (if neg (- 0 n) n))
          (set! n 0) (set! neg false) (set! digits false)))
      (inc! i))
    (ok out)))

(deftest tables-equal-c
  (let (path:String (choc-path "src/tables.c")
        src:String (try (read-file (string-as-view &path)))
        sv (string-as-view &src)
        tan (try (c-table sv "finetangent"))
        sine (try (c-table sv "finesine"))
        atan (try (c-table sv "tantoangle"))
        gamma (try (c-table sv "gammatable")))
    (try (check-eq-int (as i64 (count &tan)) 4096 "finetangent length"))
    (try (check-eq-int (as i64 (count &sine)) 10240 "finesine length"))
    (try (check-eq-int (as i64 (count &atan)) 2049 "tantoangle length"))
    (try (check-eq-int (as i64 (count &gamma)) 1280 "gammatable length"))
    (dotimes (i 4096)
      (try (check-eq-int (as i64 (aref fine-tangent-table i)) (&tan (as usize i)) "finetangent"))) ; ISSUE-046
    (dotimes (i 10240)
      (try (check-eq-int (as i64 (aref fine-sine-table i)) (&sine (as usize i)) "finesine")))
    (dotimes (i 2049)
      (try (check-eq-int (as i64 (aref tan-to-angle-table i)) (&atan (as usize i)) "tantoangle")))
    (dotimes (i 1280)
      (try (check-eq-int (as i64 (aref gamma-table i)) (&gamma (as usize i)) "gammatable")))))

(deftest rnd-table-equals-c
  (let (path:String (choc-path "src/doom/m_random.c")
        src:String (try (read-file (string-as-view &path)))
        rnd (try (c-table (string-as-view &src) "rndtable")))
    (try (check-eq-int (as i64 (count &rnd)) 256 "rndtable length"))
    (dotimes (i 256)
      (try (check-eq-int (as i64 (aref rnd-table i)) (&rnd (as usize i)) "rndtable")))))
