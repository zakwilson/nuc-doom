(import-use nucleus.io)
(import-use nucleus.error)
(import-use doom.args)
(import-use doom.main)

; Fatal errors propagate here as Results; this is the only place that exits on one.
(defn main (argc:i32 argv:ptr:CStr):int
  (args-init argc argv)
  (match (doom-main)
    ((ok) 0)
    ((err e) (eprintln "nuc-doom: " (err-message e)) 1)))
