(import-use "SDL2/SDL.h")
(import-use nucleus.io)

(defn main (argc:i32 argv:ptr):int
  (when (!= (SDL_Init SDL_INIT_VIDEO) 0)
    (println "SDL_Init failed")
    (return 1))
  (let (win (SDL_CreateWindow "nuc-doom" SDL_WINDOWPOS_UNDEFINED_MASK SDL_WINDOWPOS_UNDEFINED_MASK ; ISSUE-002
                              640 400 0))
    (when (null? win)
      (println "SDL_CreateWindow failed")
      (return 1))
    (println "hello SDL")
    (SDL_DestroyWindow win))
  (SDL_Quit)
  (return 0))
