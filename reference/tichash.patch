+// nuc-doom reference harness: -framedump <tic,tic,...> <dir> writes the
+// indexed framebuffer through the current palette as <dir>/tic%05d.ppm.
+void I_FrameDumpCheck(int tic)
+{
+    static int parsed = 0;
+    static int tics[64];
+    static int ntics = 0, done = 0;
+    static const char *dir = NULL;
+    int i;
+
+    if (!parsed)
+    {
+        int p = M_CheckParmWithArgs("-framedump", 2);
+        parsed = 1;
+        if (p > 0)
+        {
+            char *list = M_StringDuplicate(myargv[p + 1]);
+            char *tok = strtok(list, ",");
+            while (tok != NULL && ntics < 64)
+            {
+                tics[ntics++] = atoi(tok);
+                tok = strtok(NULL, ",");
+            }
+            dir = myargv[p + 2];
+        }
+    }
+    for (i = 0; i < ntics; ++i)
+    {
+        if (tics[i] == tic)
+        {
+            char path[512];
+            FILE *f;
+            int x;
+            M_snprintf(path, sizeof(path), "%s/tic%05d.ppm", dir, tic);
+            f = fopen(path, "wb");
+            if (f == NULL)
+                I_Error("framedump: cannot write %s", path);
+            fprintf(f, "P6\n%d %d\n255\n", SCREENWIDTH, SCREENHEIGHT);
+            for (x = 0; x < SCREENWIDTH * SCREENHEIGHT; ++x)
+            {
+                SDL_Color *c = &palette[I_VideoBuffer[x]];
+                fputc(c->r, f);
+                fputc(c->g, f);
+                fputc(c->b, f);
+            }
+            fclose(f);
+            tics[i] = -1;
+            if (++done == ntics)
+                exit(0);
+        }
+    }
+}
