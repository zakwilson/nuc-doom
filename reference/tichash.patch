 #include "d_loop.h"
 
+// nuc-doom reference harness: per-tic state hash (-tichash <file>).
+#include <stdio.h>
+#include <stdint.h>
+#include "p_local.h"
+
+extern int rndindex, prndindex;
+static FILE *tichash_file = NULL;
+
+static uint32_t TicHashInt(uint32_t h, int32_t v)
+{
+    uint32_t u = (uint32_t) v;
+    int b;
+    for (b = 0; b < 4; ++b)
+    {
+        h ^= (u >> (8 * b)) & 0xff;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+static void TicHashWrite(void)
+{
+    thinker_t *th;
+    uint32_t h = 2166136261u;
+    int i;
+
+    for (th = thinkercap.next; th != &thinkercap; th = th->next)
+    {
+        mobj_t *mo;
+        if (th->function.acp1 != (actionf_p1) P_MobjThinker)
+            continue;
+        mo = (mobj_t *) th;
+        h = TicHashInt(h, mo->x);
+        h = TicHashInt(h, mo->y);
+        h = TicHashInt(h, mo->z);
+        h = TicHashInt(h, (int32_t) mo->angle);
+        h = TicHashInt(h, mo->momx);
+        h = TicHashInt(h, mo->momy);
+        h = TicHashInt(h, mo->momz);
+        h = TicHashInt(h, mo->health);
+        h = TicHashInt(h, mo->type);
+        h = TicHashInt(h, (int32_t) (mo->state - states));
+        h = TicHashInt(h, mo->flags);
+    }
+    fprintf(tichash_file, "tic=%d rnd=%d prnd=%d mobj=%08x",
+            gametic, rndindex, prndindex, h);
+    for (i = 0; i < MAXPLAYERS; ++i)
+    {
+        player_t *p = &players[i];
+        if (!playeringame[i])
+            continue;
+        fprintf(tichash_file, " p%d=%d,%d,%d,%d,%d,%d", i, p->health,
+                p->armorpoints, p->readyweapon, p->killcount, p->itemcount,
+                p->secretcount);
+    }
+    fputc('\n', tichash_file);
+    fflush(tichash_file);
+}
